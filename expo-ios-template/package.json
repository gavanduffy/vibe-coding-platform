{
  "name": "expo-ios-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "build:preview": "eas build --profile preview --platform ios --non-interactive",
    "build:production": "eas build --profile production --platform ios --non-interactive",
    "update": "eas update --auto --non-interactive",
    "update:preview": "eas update --branch preview --non-interactive",
    "devices": "eas device:create",
    "credentials": "eas credentials --platform ios",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > src/types/database.ts",
    "supabase:migrate": "supabase db push",
    "supabase:functions": "supabase functions deploy"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "@react-native-async-storage/async-storage": "2.1.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "typescript": "~5.3.0",
    "expo-mcp": "latest"
  },
  "private": true
}
